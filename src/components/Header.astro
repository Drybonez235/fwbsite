---
interface Props {
  variant?: 'home' | 'blog' | 'login';
}

const { variant = 'home' } = Astro.props;
---

<header class="fixed top-0 left-0 w-full bg-white shadow z-50">
  <div class="mx-auto px-4 sm:px-6 lg:px-8 flex h-12 mt-2 mb-2 justify-between">
    <!-- Logo -->
    <div class="flex items-start space-x-2">
      <a href={variant === 'home' ? '#home' : '/'} class="h-full w-auto">
        <img src="/fwbsite_text_blank_background.avif" alt="fwbsite logo" class="h-full w-auto" />
      </a>
    </div>

    <!-- Nav Links -->
    <nav class="hidden md:flex space-x-8 items-center">
      {variant === 'home' ? (
        <>
          <a href="#home" class="text-gray-700 hover:text-blue-600 font-medium">Home</a>
          <a href="#pricing" class="text-gray-700 hover:text-blue-600 font-medium">Pricing</a>
          <a href="#about" class="text-gray-700 hover:text-blue-600 font-medium">About</a>
          <a href="#contact" class="text-gray-700 hover:text-blue-600 font-medium">Contact</a>
          <a href="/blog" class="text-gray-700 hover:text-blue-600 font-medium">Blog</a>
          <a href="/login" class="text-gray-700 hover:text-blue-600 font-medium">Login</a> 
        </>
      ) : (
        <>
          <a href="/#home" class="text-gray-700 hover:text-blue-600 font-medium">Home</a>
          <a href="/#pricing" class="text-gray-700 hover:text-blue-600 font-medium">Pricing</a>
          <a href="/#about" class="text-gray-700 hover:text-blue-600 font-medium">About</a>
          <a href="/#contact" class="text-gray-700 hover:text-blue-600 font-medium">Contact</a>
          <a href="/blog" class="text-gray-700 hover:text-blue-600 font-medium">Blog</a>
          <a href="/login" class="text-gray-700 hover:text-blue-600 font-medium">Login</a> 
        </>
      )}
    </nav>
  </div>
</header>
