---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
---

<BaseLayout title="fwbsite - Free Will Baptist Web Hosting">
  <Header variant="home" />
  
  <!-- Hero Section -->
  <section id="home" class="relative pt-24 sm:pt-28 lg:pt-32 bg-gradient-to-t from-[#6895fd] to-[#001f65] scroll-mt-20 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Main Content Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-end">
        
        <!-- Left Content Column -->
        <div class="lg:col-span-7 flex flex-col justify-between pb-8 sm:pb-12 lg:pb-12 space-y-8 sm:space-y-10">
          
          <!-- Text Content & CTA -->
          <div class="space-y-4 sm:space-y-6">
            <!-- Main Heading -->
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.1]">
              Church Websites<br />Made Simple
            </h1>

            <!-- Subheading -->
            <p class="text-lg sm:text-xl text-blue-100 font-medium leading-relaxed max-w-xl">
              Spend time on the great commission,<br class="hidden sm:inline" />
              not your website.
            </p>

            <!-- CTA Button -->
            <div class="pt-2">
              <a href="#pricing"
                class="inline-flex items-center justify-center px-7 py-3.5 sm:px-8 sm:py-4 text-base sm:text-lg font-semibold text-white bg-gradient-to-r from-[#78B6D9] to-[#4D90B5] rounded-full shadow-lg hover:shadow-xl hover:scale-105 active:scale-95 transition-all duration-200">
                See Plans
              </a>
            </div>
          </div>

          <!-- Savings Card -->
          <div class="bg-white rounded-3xl p-5 sm:p-6 lg:p-7 shadow-2xl max-w-xl w-full">
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4 sm:gap-6">
              <!-- Savings Text -->
              <h2 class="text-base sm:text-xl lg:text-2xl font-bold text-gray-900 leading-snug text-center sm:text-left">
                Save <em class="italic font-extrabold text-[#4D90B5]">hundreds</em> on your church web hosting bill.
              </h2>

              <!-- Total Savings Display -->
              <div id="total_savings_div" class="text-center flex-shrink-0 sm:border-l sm:border-gray-200 sm:pl-6 w-full sm:w-auto">
                <div id="total_savings_int"
                  class="font-extrabold text-gray-900 text-4xl sm:text-5xl tracking-tight">
                  0$
                </div>
                <p class="text-xs sm:text-sm font-semibold uppercase tracking-wider text-gray-500 mt-0.5">
                  Total Savings
                </p>
              </div>
            </div>
          </div>

        </div>

        <!-- Right Image Column -->
        <div class="lg:col-span-5 flex justify-center lg:justify-end items-end">
          <img src="/fwbsite_hero.avif" alt="A church in front of a web globe with doves flying away"
            class="w-full max-w-sm sm:max-w-md lg:max-w-none h-auto object-contain object-bottom select-none pointer-events-none drop-shadow-md" />
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing Section -->
  <section class="py-16 bg-gray-50" id="pricing">
    <div class="max-w-7xl mx-auto px-2 sm:px-6 lg:px-8">
      <div class="text-center mb-12 mt-4">
        <h2 class="text-3xl font-bold text-gray-900">Our Plans</h2>
        <p class="text-gray-600 mt-2">
          Choose the option that fits your ministry needs
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-3">
        <!-- Mission Plan -->
        <div class="bg-white rounded-xl shadow-lg overflow-hidden flex flex-col self-start">
          <div class="p-6 flex-grow flex flex-col">
            <h3 class="text-2xl font-bold text-[#4D90B5] mb-4 text-center">
              Mission Plan
            </h3>
            <p class="text-4xl font-extrabold text-gray-900 text-center">
              0<span class="text-lg font-medium">$/mo</span>
            </p>
            <p class="text-center text-sm text-gray-500 mb-6">
              WordPress Hosting
            </p>
            <ul class="space-y-2 text-gray-700 flex-grow">
              <li>✅ Complete account setup and support</li>
              <li>✅ Personalized church web address</li>
              <li>✅ Pre-built website template</li>
              
            </ul>
          </div>
          <details class="mt-4">
            <summary class="flex items-center justify-center cursor-pointer text-[#4D90B5] font-medium hover:underline">
              <span class="mr-2">Learn More</span>
              <span class="text-xl">+</span>
            </summary>
            <p class="mt-3 ml-2 text-gray-600 text-sm leading-relaxed">
              A plan for Free Will Baptist International and Home Missions churches. 
              All the features of the church basic plan, but for free! Every peny counts and so this plan is meant to be a 
              blessing to your ministry. Send me a message and you will have a website up and running in no time!
            </p>
          </details>
          <div class="p-6 text-center">
            <a href="#contact"
              class="inline-block w-full bg-[#4D90B5] text-white py-2 px-4 rounded-lg hover:bg-[#3a6d8e] transition">
              Contact Me
            </a>
          </div>
        </div>

        <!-- Church Basic Plan -->
        <div class="bg-white rounded-xl shadow-lg overflow-hidden flex flex-col self-start">
          <div class="p-6 flex-grow flex flex-col">
            <h3 class="text-2xl font-bold text-[#C63C32] mb-4 text-center">
              Church Basic
            </h3>
            <p class="text-4xl font-extrabold text-gray-900 text-center">
              5<span class="text-lg font-medium">$/mo</span>
            </p>
            <p class="text-center text-sm text-gray-500 mb-6">
              WordPress Hosting
            </p>
            <ul class="space-y-2 text-gray-700 flex-grow">
              <li>✅ Complete account setup and guidance</li>
              <li>✅ Personalized church web address</li>
              <li>✅ Pre-built church website template</li>
            </ul>
          </div>
          <details class="mt-4">
            <summary class="flex items-start justify-center cursor-pointer text-[#C63C32] font-medium hover:underline">
              <span class="mr-2">Learn More</span>
              <span class="text-xl">+</span>
            </summary>
            <p class="mt-3 ml-2 text-gray-600 text-sm leading-relaxed">
              Designed for Free Will Baptist churches launching their first
              website. Use our FWB template to fill out your church information, and watch as your website comes to life! Affordable, easy to maintain, and built to
              share your message with your community. Have a website ready in minutes.
            </p>
          </details>
          <div class="p-6 text-center">
            <a href="#contact"
              class="inline-block w-full bg-[#C63C32] text-white py-2 px-4 rounded-lg hover:bg-[#9E2A21] transition">
              Contact Me
            </a>
          </div>
        </div>

        <!-- Church Advanced Plan -->
        <div class="bg-white rounded-xl shadow-lg overflow-hidden flex flex-col self-start">
          <div class="p-6 flex-grow flex flex-col">
            <h3 class="text-2xl font-bold text-[#4D90B5] mb-4 text-center">
              Church Advanced
            </h3>
            <p class="text-4xl font-extrabold text-gray-900 text-center">
              10<span class="text-lg font-medium">$/mo</span>
            </p>
            <p class="text-center text-sm text-gray-500 mb-6">
              WordPress + Traditional Pages
            </p>
            <ul class="space-y-2 text-gray-700 flex-grow">
              <li>✅ Full setup with personal tech support</li>
              <li>✅ Fully custom domain compatable</li>
              <li>✅ Free monthly consulting sessions</li>
            </ul>
          </div>
          <details class="mt-4">
            <summary class="flex items-center justify-center cursor-pointer text-[#4D90B5] font-medium hover:underline">
              <span class="mr-2">Learn More</span>
              <span class="text-xl">+</span>
            </summary>
            <p class="mt-3 ml-2 text-gray-600 text-sm leading-relaxed">
              For churches ready to expand their online ministry. This plan
              supports both WordPress and traditional web pages, includes free
              consulting, and offers monthly edit assistance. Bring your own
              domain or let us help set one up — giving you more control and
              flexibility for your church’s online presence.
            </p>
          </details>
          <div class="p-6 text-center">
            <a href="#contact"
              class="inline-block w-full bg-[#4D90B5] text-white py-2 px-4 rounded-lg hover:bg-[#3a6d8e] transition">
              Contact Me
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final Tagline -->
  <section class="py-12 bg-[#E3EEF5] text-center">
    <p class="max-w-2xl mx-auto text-lg font-medium text-gray-800">
      fwbsite is your first step to launching a church website in an
      affordable way.
    </p>
  </section>

  <!-- Online Presence Section -->
  <section id="online-presence" class="py-20 bg-white relative overflow-hidden scroll-mt-16">
    <span id="digital-presence" class="sr-only"></span>
    <!-- Watermark Logo -->
    <img src="/fwbsite_picture_blank_background.avif" alt="" aria-hidden="true"
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] lg:w-[700px] opacity-[0.15] pointer-events-none select-none" />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <!-- Top Row: Heading and Subtext -->
      <div class="text-center mb-12 sm:mb-16 max-w-3xl mx-auto">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-gray-900 tracking-tight mb-4">
          Online Presence
        </h2>
        <p class="text-lg text-gray-600 leading-relaxed">
          fwbsite helps your church establish a complete, professional online presence. From connecting with families searching on Google to communicating with your members through custom email, enabling secure online giving, and sharing the Gospel across social platforms, we handle the technical setup so your ministry can thrive.
        </p>
      </div>

      <!-- Two Columns Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        
        <!-- Left Column: Clickable Cards -->
        <div class="lg:col-span-5 flex flex-col space-y-4" role="tablist" aria-label="Online Presence Features">
          
          <!-- Email Tab -->
          <button
            type="button"
            role="tab"
            id="tab-email"
            aria-selected="true"
            aria-controls="panel-email"
            data-presence-tab="email"
            class="presence-tab active w-full text-left flex items-center gap-4 sm:gap-5 p-5 rounded-2xl border transition-all duration-200 cursor-pointer group focus:outline-none focus-visible:ring-2 focus-visible:ring-[#4D90B5] bg-white border-[#4D90B5] shadow-lg ring-2 ring-[#4D90B5]/30 -translate-y-0.5">
            <div class="presence-icon w-14 h-14 sm:w-16 sm:h-16 rounded-2xl flex items-center justify-center shadow-md bg-gradient-to-br from-[#4D90B5] to-[#6895fd] text-white flex-shrink-0 transition-transform duration-200 group-hover:scale-105">
              <svg class="w-7 h-7 sm:w-8 sm:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div class="flex-grow min-w-0">
              <h3 class="text-lg sm:text-xl font-bold text-gray-900 group-[.active]:text-[#001f65]">
                Email
              </h3>
              <p class="text-sm text-gray-500 truncate">
                Custom church domain email addresses
              </p>
            </div>
            <svg class="tab-arrow w-5 h-5 ml-auto text-[#4D90B5] opacity-100 transition-opacity duration-200 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
            </svg>
          </button>

          <!-- Google Business Profile Tab -->
          <button
            type="button"
            role="tab"
            id="tab-google"
            aria-selected="false"
            aria-controls="panel-google"
            data-presence-tab="google"
            class="presence-tab w-full text-left flex items-center gap-4 sm:gap-5 p-5 rounded-2xl border transition-all duration-200 cursor-pointer group focus:outline-none focus-visible:ring-2 focus-visible:ring-[#4D90B5] bg-slate-50/90 border-slate-200/80 hover:bg-white hover:border-slate-300">
            <div class="presence-icon w-14 h-14 sm:w-16 sm:h-16 rounded-2xl flex items-center justify-center shadow-md bg-gradient-to-br from-[#C63C32] to-[#E85650] text-white flex-shrink-0 transition-transform duration-200 group-hover:scale-105">
              <svg class="w-7 h-7 sm:w-8 sm:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div class="flex-grow min-w-0">
              <h3 class="text-lg sm:text-xl font-bold text-gray-900 group-[.active]:text-[#001f65]">
                Google Business Profile
              </h3>
              <p class="text-sm text-gray-500 truncate">
                Google Maps & local search visibility
              </p>
            </div>
            <svg class="tab-arrow w-5 h-5 ml-auto text-gray-300 opacity-0 transition-opacity duration-200 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
            </svg>
          </button>

          <!-- Social Media Presence Tab -->
          <button
            type="button"
            role="tab"
            id="tab-social"
            aria-selected="false"
            aria-controls="panel-social"
            data-presence-tab="social"
            class="presence-tab w-full text-left flex items-center gap-4 sm:gap-5 p-5 rounded-2xl border transition-all duration-200 cursor-pointer group focus:outline-none focus-visible:ring-2 focus-visible:ring-[#4D90B5] bg-slate-50/90 border-slate-200/80 hover:bg-white hover:border-slate-300">
            <div class="presence-icon w-14 h-14 sm:w-16 sm:h-16 rounded-2xl flex items-center justify-center shadow-md bg-gradient-to-br from-[#78B6D9] to-[#4D90B5] text-white flex-shrink-0 transition-transform duration-200 group-hover:scale-105">
              <svg class="w-7 h-7 sm:w-8 sm:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5" />
              </svg>
            </div>
            <div class="flex-grow min-w-0">
              <h3 class="text-lg sm:text-xl font-bold text-gray-900 group-[.active]:text-[#001f65]">
                Social Media Presence
              </h3>
              <p class="text-sm text-gray-500 truncate">
                Facebook, Instagram & community reach
              </p>
            </div>
            <svg class="tab-arrow w-5 h-5 ml-auto text-gray-300 opacity-0 transition-opacity duration-200 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
            </svg>
          </button>

          <!-- Online Giving Tab -->
          <button
            type="button"
            role="tab"
            id="tab-giving"
            aria-selected="false"
            aria-controls="panel-giving"
            data-presence-tab="giving"
            class="presence-tab w-full text-left flex items-center gap-4 sm:gap-5 p-5 rounded-2xl border transition-all duration-200 cursor-pointer group focus:outline-none focus-visible:ring-2 focus-visible:ring-[#4D90B5] bg-slate-50/90 border-slate-200/80 hover:bg-white hover:border-slate-300">
            <div class="presence-icon w-14 h-14 sm:w-16 sm:h-16 rounded-2xl flex items-center justify-center shadow-md bg-gradient-to-br from-[#10B981] to-[#047857] text-white flex-shrink-0 transition-transform duration-200 group-hover:scale-105">
              <svg class="w-7 h-7 sm:w-8 sm:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div class="flex-grow min-w-0">
              <h3 class="text-lg sm:text-xl font-bold text-gray-900 group-[.active]:text-[#001f65]">
                Online Giving
              </h3>
              <p class="text-sm text-gray-500 truncate">
                Simple, secure tithing & donations
              </p>
            </div>
            <svg class="tab-arrow w-5 h-5 ml-auto text-gray-300 opacity-0 transition-opacity duration-200 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
            </svg>
          </button>

        </div>

        <!-- Right Column: Details and CTA Card -->
        <div class="lg:col-span-7 flex flex-col justify-between bg-slate-50/90 border border-slate-200/80 rounded-2xl p-6 sm:p-8 shadow-sm">
          
          <!-- Dynamic Details Area -->
          <div class="min-h-[280px]">
            
            <!-- Email Details Panel -->
            <div
              id="panel-email"
              role="tabpanel"
              aria-labelledby="tab-email"
              data-presence-panel="email"
              class="presence-panel animate-fadeIn">
              <div class="flex items-center gap-3 mb-3">
                <span class="px-3 py-1 text-xs font-semibold uppercase tracking-wider text-[#4D90B5] bg-sky-100 rounded-full">
                  Communication
                </span>
                <h3 class="text-2xl font-bold text-gray-900">
                  Professional Church Email
                </h3>
              </div>
              <p class="text-gray-600 leading-relaxed mb-6">
                First impressions matter. Communicating with a dedicated church address like <span class="font-semibold text-gray-800">pastor@yourchurch.org</span> establishes trust with visitors, community members, and volunteers while keeping your personal email private and secure.
              </p>
              <ul class="space-y-3 text-gray-700">
                <li class="flex items-start gap-3">
                  <span class="text-[#4D90B5] font-bold text-lg leading-none mt-0.5">✓</span>
                  <span><strong class="text-gray-900">Custom Domain Addresses:</strong> Personalized inboxes for pastors, ministry leaders, church office, and committees.</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-[#4D90B5] font-bold text-lg leading-none mt-0.5">✓</span>
                  <span><strong class="text-gray-900">Mobile & Desktop Access:</strong> Seamless setup on iPhone, Android, Apple Mail, Outlook, and webmail.</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-[#4D90B5] font-bold text-lg leading-none mt-0.5">✓</span>
                  <span><strong class="text-gray-900">Spam & Threat Protection:</strong> Built-in filtering to block junk mail and phishing attempts.</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-[#4D90B5] font-bold text-lg leading-none mt-0.5">✓</span>
                  <span><strong class="text-gray-900">Guided Setup & Support:</strong> We walk you through configuring your devices step-by-step.</span>
                </li>
              </ul>
            </div>

            <!-- Google Business Profile Details Panel -->
            <div
              id="panel-google"
              role="tabpanel"
              aria-labelledby="tab-google"
              data-presence-panel="google"
              class="presence-panel hidden">
              <div class="flex items-center gap-3 mb-3">
                <span class="px-3 py-1 text-xs font-semibold uppercase tracking-wider text-[#C63C32] bg-red-100 rounded-full">
                  Local Search
                </span>
                <h3 class="text-2xl font-bold text-gray-900">
                  Google Business Profile
                </h3>
              </div>
              <p class="text-gray-600 leading-relaxed mb-6">
                When someone in your town searches for a church on Sunday morning or looks for "churches near me", Google is their primary starting point. A verified profile puts your church directly on Google Maps and at the top of local search results.
              </p>
              <ul class="space-y-3 text-gray-700">
                <li class="flex items-start gap-3">
                  <span class="text-[#C63C32] font-bold text-lg leading-none mt-0.5">✓</span>
                  <span><strong class="text-gray-900">Google Maps Pin:</strong> Clear driving directions and navigation straight to your parking lot and front entrance.</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-[#C63C32] font-bold text-lg leading-none mt-0.5">✓</span>
                  <span><strong class="text-gray-900">Service & Meeting Times:</strong> Accurate Sunday School, morning worship, evening service, and midweek schedule.</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-[#C63C32] font-bold text-lg leading-none mt-0.5">✓</span>
                  <span><strong class="text-gray-900">Photos & Welcome Info:</strong> Showcase your church building, sanctuary, and pastoral staff so visitors feel at ease.</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-[#C63C32] font-bold text-lg leading-none mt-0.5">✓</span>
                  <span><strong class="text-gray-900">One-Tap Contact:</strong> Fast access for visitors to call your church, view your website, or ask questions.</span>
                </li>
              </ul>
            </div>

            <!-- Social Media Presence Details Panel -->
            <div
              id="panel-social"
              role="tabpanel"
              aria-labelledby="tab-social"
              data-presence-panel="social"
              class="presence-panel hidden">
              <div class="flex items-center gap-3 mb-3">
                <span class="px-3 py-1 text-xs font-semibold uppercase tracking-wider text-[#4D90B5] bg-blue-100 rounded-full">
                  Engagement
                </span>
                <h3 class="text-2xl font-bold text-gray-900">
                  Social Media Presence
                </h3>
              </div>
              <p class="text-gray-600 leading-relaxed mb-6">
                Social media helps you engage your church family throughout the week and introduce your ministry to young families searching for a welcoming church home. We provide practical guidance tailored for church volunteers.
              </p>
              <ul class="space-y-3 text-gray-700">
                <li class="flex items-start gap-3">
                  <span class="text-[#4D90B5] font-bold text-lg leading-none mt-0.5">✓</span>
                  <span><strong class="text-gray-900">Platform Strategy:</strong> Set up and organize your church Facebook, Instagram, and YouTube pages with consistent branding.</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-[#4D90B5] font-bold text-lg leading-none mt-0.5">✓</span>
                  <span><strong class="text-gray-900">Sermons & Livestreaming:</strong> Simple, realistic guidance on sharing sermon recordings, clips, and prayer updates.</span>
                </li>
                <li class="flex items-start gap-3">
                  <span class="text-[#4D90B5] font-bold text-lg leading-none mt-0.5">✓</span>
                  <span><strong class="text-gray-900">Volunteer Friendly:</strong> Realistic workflows that a volunteer or church secretary can easily maintain each week.</span>
                </li>
              </ul>
            </div>

            <!-- Online Giving Details Panel -->
            <div
              id="panel-giving"
              role="tabpanel"
