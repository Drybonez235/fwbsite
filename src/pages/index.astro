  <script is:inline>
    function setupPresenceTabs() {
      const tabs = document.querySelectorAll('[data-presence-tab]');
      const panels = document.querySelectorAll('[data-presence-panel]');
      if (!tabs.length || !panels.length) return;

      function activateTab(targetId) {
        tabs.forEach((tab) => {
          const isMatch = tab.getAttribute('data-presence-tab') === targetId;
          tab.setAttribute('aria-selected', isMatch ? 'true' : 'false');
          const arrow = tab.querySelector('.tab-arrow');

          if (isMatch) {
            tab.classList.remove('bg-slate-50/90', 'border-slate-200/80', 'hover:bg-white', 'hover:border-slate-300');
            tab.classList.add('bg-white', 'border-[#4D90B5]', 'shadow-lg', 'ring-2', 'ring-[#4D90B5]/30', '-translate-y-0.5', 'active');
            if (arrow) {
              arrow.classList.remove('opacity-0', 'text-gray-300');
              arrow.classList.add('opacity-100', 'text-[#4D90B5]');
            }
          } else {
            tab.classList.remove('bg-white', 'border-[#4D90B5]', 'shadow-lg', 'ring-2', 'ring-[#4D90B5]/30', '-translate-y-0.5', 'active');
            tab.classList.add('bg-slate-50/90', 'border-slate-200/80', 'hover:bg-white', 'hover:border-slate-300');
            if (arrow) {
              arrow.classList.remove('opacity-100', 'text-[#4D90B5]');
              arrow.classList.add('opacity-0', 'text-gray-300');
            }
          }
        });

        panels.forEach((panel) => {
          const isMatch = panel.getAttribute('data-presence-panel') === targetId;
          if (isMatch) {
            panel.classList.remove('hidden');
            panel.classList.add('animate-fadeIn');
          } else {
            panel.classList.add('hidden');
            panel.classList.remove('animate-fadeIn');
          }
        });
      }

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const id = tab.getAttribute('data-presence-tab');
          if (id) activateTab(id);
        });
        tab.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            const id = tab.getAttribute('data-presence-tab');
            if (id) activateTab(id);
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupPresenceTabs);
    } else {
      setupPresenceTabs();
    }
  </script>

